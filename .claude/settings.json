{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|Edit|MultiEdit|NotebookEdit|Write|Bash|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "git -c 'alias.factory-hook=!sh .factory/agents/claude-hook' factory-hook; exit $LASTEXITCODE",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
