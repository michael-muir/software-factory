{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|Edit|MultiEdit|NotebookEdit|Write|Bash|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.factory/agents/claude-hook\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
