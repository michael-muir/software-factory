@@ -0,0 +1,11 @@
+"""greet keeps each name as it was typed."""
+
+from greet import greet
+
+
+def test_greets_by_name() -> None:
+    assert greet("Ada") == "Hello, Ada!"
+
+
+def test_keeps_the_names_case() -> None:
+    assert greet("McDonald") == "Hello, McDonald!"
